# Copy to .env and replace every placeholder. Never commit .env.
MINIO_USER=replace-with-minio-admin-user
MINIO_PASS=replace-with-a-long-minio-password
MINIO_ENDPOINT=http://minio:9000

# Use a non-default ClickHouse user with only the required pipeline permissions.
CLICKHOUSE_USER=crypto_pipeline
CLICKHOUSE_PASS=replace-with-a-long-clickhouse-password

GRAFANA_PASS=replace-with-a-long-grafana-admin-password
KAFKA_HOST=localhost
KAFKA_INTERNAL_HOST=kafka:29092
SPARK_MASTER_URL=spark://spark-master:7077

# Keep Kafka, MinIO, Spark, and ClickHouse local to the VPS by default.
HOST_BIND_ADDRESS=127.0.0.1

# Keep Grafana private by default. Access it through an SSH tunnel or a
# HTTPS reverse proxy; do not open TCP/3000 in Oracle Cloud or the VPS firewall.
GRAFANA_BIND_ADDRESS=127.0.0.1

# Approved Spot Binance MVP universe (ten liquid USDT pairs).
CRYPTO_SYMBOLS=btcusdt,ethusdt,solusdt,bnbusdt,xrpusdt,dogeusdt,adausdt,trxusdt,avaxusdt,linkusdt

# Historical closed one-minute Kline backfill. This job is manual and is never
# started by deployment; it has no Binance API key requirement.
KLINE_BACKFILL_DAYS=365
KLINE_REQUEST_DELAY_SECONDS=0.15
KLINE_MAX_RETRIES=5

# Pipeline behavior
ALERT_PRICE_CHANGE_PCT=1.0
SILVER_WATERMARK=5 minutes
